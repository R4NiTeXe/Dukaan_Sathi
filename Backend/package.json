{
  "name": "ai-billing-backend",
  "version": "1.0.0",
  "description": "Backend for AI Billing Platform",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src --watch .env src/index.js",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:watch": "node --watch --test \"tests/**/*.test.mjs\"",
    "pretest": "npm run lint",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.mjs\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.14.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "artillery": "^2.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2"
  }
}
