# Copy this file to .env and fill in real values

# Server port (default: 8000)
PORT=8000

# MongoDB connection string (required) — e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb+srv://your_mongodb_uri

# Database name (default: ai-billing)
# DB_NAME=ai-billing

# JWT secrets (required) — at least 16 characters
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Token lifetimes (default: 7d / 30d) — format: 15m, 2h, 7d, 30d
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Google Gemini (required) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# Cloudinary (required) — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate limiting: max requests per 15 minutes per IP (default: 300)
RATE_LIMIT_MAX=300

# Comma-separated allowed origins, e.g. http://localhost:5173,https://your-app.onrender.com
# Leave unset to allow all origins
CORS_ORIGIN=http://localhost:5173
