# Same-origin path — the Next.js proxy (next.config.mjs) forwards this to the
# backend defined in BACKEND_API_URL. No CORS, works on any host.
NEXT_PUBLIC_API_URL=/api/v1

# Backend origin for the Next.js proxy (only used at build/start time).
# REQUIRED in production, e.g. https://your-backend.onrender.com
# BACKEND_API_URL=http://localhost:8000
